ENVIRONMENT=local
DEBUG=true

SECRET_KEY=replace-with-a-real-random-secret-before-any-shared-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Local default: SQLite file, zero setup required.
DATABASE_URL=sqlite:///./quantumfinguard.db
# Staging/production example:
# DATABASE_URL=postgresql://user:password@host:5432/quantumfinguard

# Optional — leave unset until Phase 8 populates the graph.
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

MODEL_ARTIFACT_DIR=./app/ml_artifacts
# Set only once Phase 5 has trained and saved a real model.
ACTIVE_FRAUD_MODEL_VERSION=

RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
# When real dataset files aren't present at RAW_DATA_DIR, the pipeline
# falls back to a clearly-labeled synthetic generator. Set to false to
# force a hard failure instead (useful to confirm real data is really
# being used, e.g. before a research run).
ALLOW_SYNTHETIC_DATA_FALLBACK=true

# Optional — RAG Investigation Copilot falls back to a deterministic,
# clearly-labeled evidence digest (not an AI-generated response) when
# this is unset. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=INFO
LOG_JSON=true
